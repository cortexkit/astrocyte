# Test vectors are exact producer bytes. Tests pin some of them by checksum,
# so git must never rewrite their line endings when it checks them out (the
# Windows CI runner converts LF to CRLF for text files by default).
crates/*/tests/vectors/** -text
crates/*/test-vectors/** -text

# Keep the recorded THALAMUS Pi folder byte-exact even if the generic rules change.
crates/astrocyte-module/tests/vectors/thalamus-pi-session-folder-v1/** -text
